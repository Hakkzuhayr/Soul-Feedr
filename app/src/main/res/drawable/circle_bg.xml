<?xml version="1.0" encoding="utf-8"?>
<!-- Glowing "moon" play button -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#330B1030">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:centerX="0.4"
                android:centerY="0.35"
                android:gradientRadius="70%"
                android:startColor="#FFFFFDF4"
                android:endColor="#FFC8CFEA" />
        </shape>
    </item>
</ripple>
